{%- liquid
  assign is_logged_in = false
  if customer
    assign is_logged_in = true
  endif
  # Unique, CSS-safe suffix so each block instance scopes its own styles.
  assign uid = block.id | replace: '-', '' | replace: '_', ''
  assign s = block.settings
-%}

{%- style -%}
  .cart-draft-order--{{ uid }} {
    text-align: {{ s.text_align }};
    margin-top: {{ s.margin_top }}px;
    margin-bottom: {{ s.margin_bottom }}px;
  }
  .cart-draft-order--{{ uid }} .cart-draft-order__button {
    display: {% if s.full_width %}block{% else %}inline-block{% endif %};
    width: {% if s.full_width %}100%{% else %}auto{% endif %};
    color: {{ s.text_color }};
    background-color: {{ s.background_color }};
    border-style: solid;
    border-width: {{ s.border_width }}px;
    border-color: {{ s.border_color }};
    border-radius: {{ s.border_radius }}px;
    padding: {{ s.padding_vertical }}px {{ s.padding_horizontal }}px;
    font-size: {{ s.font_size }}px;
    font-weight: {{ s.font_weight }};
    line-height: 1.2;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .cart-draft-order--{{ uid }} .cart-draft-order__button:hover {
    color: {{ s.text_color_hover }};
    background-color: {{ s.background_color_hover }};
    border-color: {{ s.border_color_hover }};
  }
  .cart-draft-order--{{ uid }} .cart-draft-order__button[disabled] {
    opacity: 0.6;
    cursor: default;
  }
  .cart-draft-order--{{ uid }} .cart-draft-order__message {
    margin-top: 8px;
    color: {{ s.message_color }};
    font-size: {{ s.message_font_size }}px;
  }
{%- endstyle -%}

<div
  class="cart-draft-order cart-draft-order--{{ uid }}"
  data-proxy-url="/apps/draft-cart/create-draft-order"
  data-logged-in="{{ is_logged_in }}"
  data-login-url="{{ routes.account_login_url }}"
  data-return-url="{{ routes.cart_url }}"
  data-success-message="{{ s.success_message | escape }}"
  {{ block.shopify_attributes }}
>
  <button type="button" class="cart-draft-order__button">
    {{ s.button_label | default: 'Create draft order' }}
  </button>
  <p class="cart-draft-order__message" role="status" hidden></p>
</div>

{% schema %}
{
  "name": "Create draft order",
  "target": "section",
  "enabled_on": {
    "templates": ["cart"]
  },
  "javascript": "cart-draft-order.js",
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Create draft order"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width button",
      "default": true
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color_hover",
      "label": "Text color (hover)",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "background_color_hover",
      "label": "Background color (hover)",
      "default": "#333333"
    },
    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "border_color_hover",
      "label": "Border color (hover)",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Padding (top & bottom)",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Padding (left & right)",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Confirmation message"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "info": "Shown after the draft order is created. {name} is replaced with the order name.",
      "default": "Draft order {name} created. We'll be in touch to complete it."
    },
    {
      "type": "color",
      "id": "message_color",
      "label": "Message text color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "message_font_size",
      "label": "Message font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    }
  ]
}
{% endschema %}
